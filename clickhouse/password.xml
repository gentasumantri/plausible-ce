<!--
Requires auth on the default user. Without this, CLICKHOUSE_SKIP_USER_SETUP=1
leaves the default user passwordless, so anything that reaches the app network
gets full access, and 24.12 is EOL with an unpatched unauthenticated RCE
(CVE-2026-116366).

The value is read from the environment so no secret lands in this repo.
-->
<clickhouse>
    <users>
        <default>
            <password from_env="CLICKHOUSE_DEFAULT_PASSWORD" replace="replace"/>
        </default>
    </users>
</clickhouse>
